[user]
	name = Andrés Bretón
	email = bretonics@users.noreply.github.com
[commit]
	gpgsign = true
[init]
	defaultBranch = main
	templatedir = ~/.git_templates
[alias]
	cdiff = "diff -w -G'^[^#]'"
	# Look at a pretty graph of all history that has been dropped, e.g.) dropped stashes: https://stackoverflow.com/questions/89332/how-to-recover-a-dropped-stash-in-git
	graph-dropped = "git log --graph --decorate --oneline $(git fsck --no-reflogs | awk '/dangling commit/ {print $3}')"
	log-pretty = "log --pretty=short -n 50 --graph --abbrev-commit"
[pull]
	rebase = true
[core]
	pager = diff-highlight | less -FRX
	editor = vim
[pager]
	show = diff-highlight
	diff = diff-highlight
[color]
	ui = always
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[hooks]
	prepare-commit-msg = true
[push]
	autoSetupRemote = true
#===============================================================================================
# macOS-specific Configs
#===============================================================================================
[includeIf "gitdir:/Users/"]
    path = ~/.gitconfig-macos
#===============================================================================================
# Linux/macOS formats (starts with /), load Unix config
#===============================================================================================
[includeIf "gitdir:/"]
    path = ~/.gitconfig-unix
