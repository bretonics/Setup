#-----------------------------------------------------------------------------------------------
# OS SPECIFIC ALIASES
#-----------------------------------------------------------------------------------------------
case "${OSTYPE}" in
    Darwin*|darwin*)
        alias  ls="ls -GFh"
        alias  ll="ls -laGFh"
        ;;
    Linux*|linux*)
        alias  ls="ls -GFh --color=yes"
        alias  ll="ls -GFhla --color=yes"
        ;;
esac

#-----------------------------------------------------------------------------------------------
# GENERAL ALIASES
#-----------------------------------------------------------------------------------------------
alias  cp="cp -i"
alias  rm="rm -i"
alias  mv="mv -i"
alias  vi="vim"
alias  catt="bat --style=plain --paging=never"

# Beautify $PATH
alias print-path='echo $PATH | tr -s ":" "\n"'
alias print-fpath='echo $FPATH | tr -s ":" "\n"'

# Git
alias  gs="git status"
alias  gc="git commit"

# Development
alias  pn="pnpm"
